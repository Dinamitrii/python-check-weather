# Get a key from https://openweathermap.org and copy this file to .env
API_KEY=your_openweathermap_key_here
# Public base URL used for canonical links and the QR code
BASE_URL=https://predictorian.site

# Key that machine clients (the AEO MCP server, other integrations) must
# send as the X-API-Key header to use /api/weather and /api/popular.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=generate_a_long_random_value_here

# Optional: override where the query-log SQLite file is written.
# QUERY_LOG_DB=/var/lib/predictorian/query_log.sqlite3
