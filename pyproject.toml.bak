[project]
name = "python-check-weather"
version = "0.1.0"
description = "Add your description here"
readme = "README.md"
authors = [
    { name = "dinamitrii", email = "k_karaivanov@abv.bg" }
]
requires-python = ">=3.13"
dependencies = [
    "flake8==7.4.1",
    "flask>=3.1.3",
    "pytest==9.1.1",
    "python-dotenv>=1.2.4",
    "pywrangler>=0.0.2",
    "requests==2.34.2",
    "segno>=1.6.6",
    "waitress>=3.0.2",
]

[project.scripts]
python-check-weather = "python_check_weather:main"

[build-system]
requires = ["uv_build>=0.13.5,<0.14.0"]
build-backend = "uv_build"
